<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".VehiculoActivity">

    <ScrollView
        android:id="@+id/scrollVehiculo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/contenedorVehiculo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/txtTituloVehiculo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/vehiculo_titulo"
                android:textSize="28sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/txtAsegurado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/vehiculo_asegurado"
                android:textSize="16sp"
                android:layout_marginBottom="24dp" />

            <EditText
                android:id="@+id/inputPatente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:hint="@string/vehiculo_patente"
                android:inputType="textCapCharacters" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/vehiculo_marca"
                android:layout_marginTop="16dp" />

            <Spinner
                android:id="@+id/spinnerMarca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/vehiculo_modelo"
                android:layout_marginTop="16dp" />

            <Spinner
                android:id="@+id/spinnerModelo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <EditText
                android:id="@+id/inputAnio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:hint="@string/vehiculo_anio"
                android:inputType="number"
                android:layout_marginTop="12dp" />

            <EditText
                android:id="@+id/inputSumaAsegurada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:hint="@string/vehiculo_suma_asegurada"
                android:inputType="numberDecimal"
                android:layout_marginTop="12dp" />

            <EditText
                android:id="@+id/inputUso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:hint="@string/vehiculo_uso"
                android:inputType="textCapWords"
                android:layout_marginTop="12dp" />

            <Button
                android:id="@+id/btnContinuarVehiculo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_continuar"
                android:layout_marginTop="24dp"
                android:onClick="continuarVehiculo" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>